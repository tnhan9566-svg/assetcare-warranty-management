# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ============================================================================
# MICROSOFT SQL SERVER CONFIGURATION (Copy sang file .env khi chạy trên máy)
# ============================================================================
# Đặt DB_ENABLED=true để kết nối trực tiếp với SQL Server trên máy Windows
DB_ENABLED=false
DB_SERVER=localhost
DB_PORT=1433
# Nếu dùng SQL Server Express có tên instance (ví dụ SQLEXPRESS), điền vào đây và để trống DB_PORT
DB_INSTANCE=
DB_NAME=AssetCareDB
DB_USER=sa
DB_PASSWORD=YourStrongPassword123
DB_ENCRYPT=false
DB_TRUST_CERT=true
